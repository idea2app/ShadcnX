{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "jsxImportSource": "commander-jsx",
    "rootDir": "./source",
    "outDir": "./dist"
  },
  "include": ["source/**/*"]
}
